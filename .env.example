NODE_ENV=development
PORT=3000
LOG_LEVEL=info

SLACK_BOT_TOKEN=xoxb-placeholder
SLACK_APP_TOKEN=xapp-placeholder
SLACK_SIGNING_SECRET=placeholder

GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=12345678
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=placeholder

DATABASE_PATH=./data/slack-coding-agent.sqlite
# Set DATABASE_URL to a pooled Neon/PostgreSQL URL for the running service.
# Set DATABASE_URL_UNPOOLED to the matching direct URL for npm run db:migrate.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
ALLOWED_REPOSITORIES=owner/repository
